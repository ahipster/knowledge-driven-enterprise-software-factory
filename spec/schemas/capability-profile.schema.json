{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahipster/knowledge-driven-enterprise-software-factory/blob/main/spec/schemas/capability-profile.schema.json",
  "title": "KDESF Capability Knowledge Profile v0.1",
  "description": "Every governed capability uses a scoped, versioned template. Requiredness of content families is evaluated by policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityId",
    "profileRevisionId",
    "name",
    "homeDomainId",
    "owner",
    "classification",
    "governanceProfileId",
    "dependencies",
    "requiredArtifacts"
  ],
  "properties": {
    "capabilityId": {
      "type": "string",
      "pattern": "^urn:kdesf:"
    },
    "profileRevisionId": {
      "type": "string",
      "pattern": "^urn:kdesf:"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parentCapabilityId": {
      "type": "string",
      "pattern": "^urn:kdesf:"
    },
    "homeDomainId": {
      "type": "string",
      "pattern": "^urn:kdesf:"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "scopeId"
      ],
      "properties": {
        "roleId": {
          "type": "string",
          "pattern": "^urn:kdesf:"
        },
        "scopeId": {
          "type": "string",
          "pattern": "^urn:kdesf:"
        },
        "assignedActorId": {
          "type": "string",
          "pattern": "^urn:kdesf:"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "type": "string",
          "format": "date-time"
        },
        "delegationId": {
          "type": "string",
          "pattern": "^urn:kdesf:"
        }
      }
    },
    "classification": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "outcomeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:kdesf:"
      },
      "uniqueItems": true
    },
    "processFamilyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:kdesf:"
      },
      "uniqueItems": true
    },
    "informationDomainIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:kdesf:"
      },
      "uniqueItems": true
    },
    "logicalInterfaceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:kdesf:"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:kdesf:"
      },
      "uniqueItems": true
    },
    "governanceProfileId": {
      "type": "string",
      "pattern": "^urn:kdesf:"
    },
    "assurancePolicyId": {
      "type": "string",
      "pattern": "^urn:kdesf:"
    },
    "roleBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roleId",
          "scopeId"
        ],
        "properties": {
          "roleId": {
            "type": "string",
            "pattern": "^urn:kdesf:"
          },
          "scopeId": {
            "type": "string",
            "pattern": "^urn:kdesf:"
          },
          "assignedActorId": {
            "type": "string",
            "pattern": "^urn:kdesf:"
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validTo": {
            "type": "string",
            "format": "date-time"
          },
          "delegationId": {
            "type": "string",
            "pattern": "^urn:kdesf:"
          }
        }
      }
    },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "gate"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string"
          },
          "minimumCount": {
            "type": "integer",
            "minimum": 0
          },
          "applicability": {
            "enum": [
              "required",
              "not-applicable",
              "pending-assessment"
            ]
          }
        }
      }
    },
    "reviewCadenceDays": {
      "type": "integer",
      "minimum": 1
    },
    "referenceMappings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:kdesf:"
      },
      "uniqueItems": true
    }
  }
}
